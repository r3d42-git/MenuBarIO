  "cards": [
    {
      "dot": "cyan",
      "title": "Composed in MenuBarIOApp",
      "items": [
        "StateObjects live at app level.",
        "MenuBarExtra and legacy settings share the managers."
      ]
    },
    {
      "dot": "emerald",
      "title": "One local process",
      "items": [
        "SwiftUI / Combine; macOS 13+, arm64 + x86_64.",
        "No cloud database, telemetry, or update check."
      ]
    },
    {
      "dot": "amber",
      "title": "Refresh is separate",
      "items": [
        "The lifecycle coordinator coalesces wake / session / manual refreshes.",
        "Source monitors also react directly to events."
      ]
    }
  ]
